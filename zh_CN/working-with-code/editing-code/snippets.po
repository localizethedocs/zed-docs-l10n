#: src/snippets.md:3
msgid "Snippets"
msgstr ""

#: src/snippets.md:5
msgid ""
"Use the <code class=\"hljs\">snippets: configure snippets</code> action to "
"create a new snippets file or edit an existing snippets file for a specified "
"[scope](#scopes)."
msgstr ""

#: src/snippets.md:7
msgid ""
"The snippets are located in `~/.config/zed/snippets` directory to which you "
"can navigate to with the <code class=\"hljs\">snippets: open folder</code> "
"action."
msgstr ""

#: src/snippets.md:9
msgid "Example configuration"
msgstr ""

#: src/snippets.md:13
msgid ""
"// Each snippet must have a name and body, but the prefix and description "
"are optional.\n"
"  // The prefix is used to trigger the snippet, but when omitted then the "
"name is used.\n"
"  // Use placeholders like $1, $2 or ${1:defaultValue} to define tab stops.\n"
"  // The $0 determines the final cursor position.\n"
"  // Placeholders with the same value are linked.\n"
"  // If the snippet contains the $ symbol outside of a placeholder, it must "
"be escaped with two slashes (e.g. \\\\$var).\n"
"  \"Log to console\""
msgstr ""

