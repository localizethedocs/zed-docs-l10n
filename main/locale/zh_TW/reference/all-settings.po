msgstr ""

#: src/reference/all-settings.md:4471
msgid "Setting: `path_hyperlink_regexes`"
msgstr ""

#: src/reference/all-settings.md:4477
msgid "\"path_hyperlink_regexes\""
msgstr ""

#: src/reference/all-settings.md:4478
msgid ""
"// Python-style diagnostics\n"
"      \"File \\\"(?<path>[^\\\"]+)\\\", line (?<line>[0-9]+)\""
msgstr ""

#: src/reference/all-settings.md:4480
msgid ""
"// Common path syntax with optional line, column, description, trailing "
"punctuation, or\n"
"      // surrounding symbols or quotes\n"
msgstr ""

#: src/reference/all-settings.md:4483
msgid "\"(?x)\""
msgstr ""

#: src/reference/all-settings.md:4484
msgid "\"# optionally starts with 0-2 opening prefix symbols\""
msgstr ""

#: src/reference/all-settings.md:4485
msgid "\"[({\\\\[<]{0,2}\""
msgstr ""

#: src/reference/all-settings.md:4486
msgid "\"# which may be followed by an opening quote\""
msgstr ""

#: src/reference/all-settings.md:4487
msgid "\"(?<quote>[\\\"'`])?\""
msgstr ""

#: src/reference/all-settings.md:4488
msgid "\"# `path` is the shortest sequence of any non-space character\""
msgstr ""

#: src/reference/all-settings.md:4489
msgid "\"(?<link>(?<path>[^ ]+?\""
msgstr ""

#: src/reference/all-settings.md:4490
msgid "\"    # which may end with a line and optionally a column,\""
msgstr ""

#: src/reference/all-settings.md:4491
msgid ""
"\"    (?<line_column>:+[0-9]+(:[0-9]+)?|:?\\\\([0-9]+([,:][0-9]+)?\\\\))?\""
msgstr ""

#: src/reference/all-settings.md:4492
msgid "\"))\""
msgstr ""

#: src/reference/all-settings.md:4493
msgid "\"# which must be followed by a matching quote\""
msgstr ""

#: src/reference/all-settings.md:4494
msgid "\"(?(<quote>)\\\\k<quote>)\""
msgstr ""

#: src/reference/all-settings.md:4495
msgid "\"# and optionally a single closing symbol\""
msgstr ""

#: src/reference/all-settings.md:4496
msgid "\"[)}\\\\]>]?\""
msgstr ""

#: src/reference/all-settings.md:4497
msgid "\"# if line/column matched, may be followed by a description\""
msgstr ""

#: src/reference/all-settings.md:4498
msgid "\"(?(<line_column>):[^ 0-9][^ ]*)?\""
msgstr ""

#: src/reference/all-settings.md:4499
msgid "\"# which may be followed by trailing punctuation\""
msgstr ""

#: src/reference/all-settings.md:4500
msgid "\"[.,:)}\\\\]>]*\""
msgstr ""

#: src/reference/all-settings.md:4501
msgid "\"# and always includes trailing whitespace or end of line\""
msgstr ""

#: src/reference/all-settings.md:4502
msgid "\"([ ]+|$)\""
msgstr ""

