msgstr ""

#: src/reference/all-settings.md:4247
msgid ""
"// Python-style diagnostics\n"
"      \"File \\\"(?<path>[^\\\"]+)\\\", line (?<line>[0-9]+)\""
msgstr ""

#: src/reference/all-settings.md:4249
msgid ""
"// Common path syntax with optional line, column, description, trailing "
"punctuation, or\n"
"      // surrounding symbols or quotes\n"
msgstr ""

#: src/reference/all-settings.md:4252
msgid "\"(?x)\""
msgstr ""

#: src/reference/all-settings.md:4253
msgid "\"# optionally starts with 0-2 opening prefix symbols\""
msgstr ""

#: src/reference/all-settings.md:4254
msgid "\"[({\\\\[<]{0,2}\""
msgstr ""

#: src/reference/all-settings.md:4255
msgid "\"# which may be followed by an opening quote\""
msgstr ""

#: src/reference/all-settings.md:4256
msgid "\"(?<quote>[\\\"'`])?\""
msgstr ""

#: src/reference/all-settings.md:4257
msgid "\"# `path` is the shortest sequence of any non-space character\""
msgstr ""

#: src/reference/all-settings.md:4258
msgid "\"(?<link>(?<path>[^ ]+?\""
msgstr ""

#: src/reference/all-settings.md:4259
msgid "\"    # which may end with a line and optionally a column,\""
msgstr ""

#: src/reference/all-settings.md:4260
msgid ""
"\"    (?<line_column>:+[0-9]+(:[0-9]+)?|:?\\\\([0-9]+([,:][0-9]+)?\\\\))?\""
msgstr ""

#: src/reference/all-settings.md:4261
msgid "\"))\""
msgstr ""

#: src/reference/all-settings.md:4262
msgid "\"# which must be followed by a matching quote\""
msgstr ""

#: src/reference/all-settings.md:4263
msgid "\"(?(<quote>)\\\\k<quote>)\""
msgstr ""

#: src/reference/all-settings.md:4264
msgid "\"# and optionally a single closing symbol\""
msgstr ""

