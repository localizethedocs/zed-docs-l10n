msgstr ""

#: src/configuring-zed.md:4266
msgid ""
"// Python-style diagnostics\n"
"      \"File \\\"(?<path>[^\\\"]+)\\\", line (?<line>[0-9]+)\""
msgstr ""

#: src/configuring-zed.md:4268
msgid ""
"// Common path syntax with optional line, column, description, trailing "
"punctuation, or\n"
"      // surrounding symbols or quotes\n"
msgstr ""

#: src/configuring-zed.md:4271
msgid "\"(?x)\""
msgstr ""

#: src/configuring-zed.md:4272
msgid "\"# optionally starts with 0-2 opening prefix symbols\""
msgstr ""

#: src/configuring-zed.md:4273
msgid "\"[({\\\\[<]{0,2}\""
msgstr ""

#: src/configuring-zed.md:4274
msgid "\"# which may be followed by an opening quote\""
msgstr ""

#: src/configuring-zed.md:4275
msgid "\"(?<quote>[\\\"'`])?\""
msgstr ""

#: src/configuring-zed.md:4276
msgid "\"# `path` is the shortest sequence of any non-space character\""
msgstr ""

#: src/configuring-zed.md:4277
msgid "\"(?<link>(?<path>[^ ]+?\""
msgstr ""

#: src/configuring-zed.md:4278
msgid "\"    # which may end with a line and optionally a column,\""
msgstr ""

#: src/configuring-zed.md:4279
msgid ""
"\"    (?<line_column>:+[0-9]+(:[0-9]+)?|:?\\\\([0-9]+([,:][0-9]+)?\\\\))?\""
msgstr ""

#: src/configuring-zed.md:4280
msgid "\"))\""
msgstr ""

#: src/configuring-zed.md:4281
msgid "\"# which must be followed by a matching quote\""
msgstr ""

#: src/configuring-zed.md:4282
msgid "\"(?(<quote>)\\\\k<quote>)\""
msgstr ""

#: src/configuring-zed.md:4283
msgid "\"# and optionally a single closing symbol\""
msgstr ""

#: src/configuring-zed.md:4284
msgid "\"[)}\\\\]>]?\""
msgstr ""

#: src/configuring-zed.md:4285
msgid "\"# if line/column matched, may be followed by a description\""
msgstr ""

#: src/configuring-zed.md:4286
msgid "\"(?(<line_column>):[^ 0-9][^ ]*)?\""
msgstr ""

#: src/configuring-zed.md:4287
msgid "\"# which may be followed by trailing punctuation\""
msgstr ""

#: src/configuring-zed.md:4288
msgid "\"[.,:)}\\\\]>]*\""
msgstr ""

#: src/configuring-zed.md:4289
msgid "\"# and always includes trailing whitespace or end of line\""
msgstr ""

#: src/configuring-zed.md:4290
msgid "\"([ ]+|$)\""
