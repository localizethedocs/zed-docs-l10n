msgid ""
"// The label for the debug configuration and used to identify the debug "
"session inside the debug panel & new process modal\n"
"    \"label\""
msgstr ""

#: src/debugger.md:92
msgid "\"Example Start debugger config\""
msgstr ""

#: src/debugger.md:93
msgid ""
"// The debug adapter that Zed should use to debug the program\n"
"    \"adapter\""
msgstr ""

#: src/debugger.md:94
msgid "\"Example adapter name\""
msgstr ""

#: src/debugger.md:95
msgid ""
"// Request:\n"
"    //  - launch: Zed will launch the program if specified, or show a debug "
"terminal with the right configuration\n"
"    //  - attach: Zed will attach to a running program to debug it, or when "
"the process_id is not specified, will show a process picker (only supported "
"for node currently)\n"
"    \"request\""
msgstr ""

#: src/debugger.md:98 src/debugger.md:119 src/debugger.md:136
msgid "\"launch\""
msgstr ""

#: src/debugger.md:99
msgid ""
"// The program to debug. This field supports path resolution with ~ or . "
