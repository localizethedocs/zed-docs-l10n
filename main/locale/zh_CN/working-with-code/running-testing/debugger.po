"    \"cwd\""
msgstr ""

#: src/debugger.md:102
msgid "\"$ZED_WORKTREE_ROOT\""
msgstr ""

#: src/debugger.md:107
msgid ""
"Check your debug adapter's documentation for more information on the fields "
"it supports."
msgstr ""

