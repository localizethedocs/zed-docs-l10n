#: src/reference/cli.md:50
msgid "`-w`, `--wait`"
msgstr ""

#: src/reference/cli.md:52
msgid ""
"Wait for all opened files to be closed before the CLI exits. When opening a "
"directory, waits until the window is closed."
msgstr ""

#: src/reference/cli.md:54
msgid ""
"This is useful for integrating Zed with tools that expect an editor to block "
"until editing is complete (e.g., `git commit`):"
msgstr ""

#: src/reference/cli.md:57 src/reference/cli.md:166 src/reference/cli.md:167
msgid "\"zed --wait\""
msgstr ""

#: src/reference/cli.md:58
msgid "# Opens Zed and waits for you to close the commit message file\n"
msgstr ""

#: src/reference/cli.md:61
msgid "`-n`, `--new`"
msgstr ""

#: src/reference/cli.md:63
msgid ""
"Open paths in a new workspace window, even if the paths are already open in "
"an existing window:"
msgstr ""

#: src/reference/cli.md:69
msgid "`-a`, `--add`"
msgstr ""

#: src/reference/cli.md:71
msgid ""
"Add paths to the currently focused workspace instead of opening a new "
"window. When multiple workspace windows are open, files open in the focused "
"window:"
msgstr ""

#: src/reference/cli.md:77
msgid "`-r`, `--reuse`"
msgstr ""

#: src/reference/cli.md:79
msgid ""
"Reuse an existing window, replacing its current workspace with the new paths:"
msgstr ""

