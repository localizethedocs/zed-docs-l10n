msgid ""
"Add the symbols to the perf database: `perf buildid-cache -v -a <path to "
"release zed binary>`"
msgstr ""

#: src/development/linux.md:207
msgid ""
"Resolve the symbols from the db: `perf inject -i perf.data -o "
"perf_with_symbols.data`"
msgstr ""

