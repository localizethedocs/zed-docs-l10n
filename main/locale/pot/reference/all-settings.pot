#: src/reference/all-settings.md:4451
msgid "Terminal: Path Hyperlink Regexes"
msgstr ""

#: src/reference/all-settings.md:4453
msgid ""
"Description: Regexes used to identify path hyperlinks. The regexes can be "
"specified in two forms - a single regex string, or an array of strings "
"(which will be collected into a single multi-line regex string)."
msgstr ""

#: src/reference/all-settings.md:4454
msgid "Setting: `path_hyperlink_regexes`"
msgstr ""

#: src/reference/all-settings.md:4460
msgid "\"path_hyperlink_regexes\""
msgstr ""

#: src/reference/all-settings.md:4461
msgid ""
"// Python-style diagnostics\n"
"      \"File \\\"(?<path>[^\\\"]+)\\\", line (?<line>[0-9]+)\""
msgstr ""

#: src/reference/all-settings.md:4463
msgid ""
"// Common path syntax with optional line, column, description, trailing "
"punctuation, or\n"
"      // surrounding symbols or quotes\n"
msgstr ""

#: src/reference/all-settings.md:4466
msgid "\"(?x)\""
msgstr ""

#: src/reference/all-settings.md:4467
msgid "\"# optionally starts with 0-2 opening prefix symbols\""
msgstr ""

#: src/reference/all-settings.md:4468
msgid "\"[({\\\\[<]{0,2}\""
msgstr ""

#: src/reference/all-settings.md:4469
msgid "\"# which may be followed by an opening quote\""
msgstr ""

#: src/reference/all-settings.md:4470
msgid "\"(?<quote>[\\\"'`])?\""
msgstr ""

#: src/reference/all-settings.md:4471
msgid "\"# `path` is the shortest sequence of any non-space character\""
msgstr ""

#: src/reference/all-settings.md:4472
msgid "\"(?<link>(?<path>[^ ]+?\""
msgstr ""

#: src/reference/all-settings.md:4473
msgid "\"    # which may end with a line and optionally a column,\""
msgstr ""

#: src/reference/all-settings.md:4474
msgid ""
"\"    (?<line_column>:+[0-9]+(:[0-9]+)?|:?\\\\([0-9]+([,:][0-9]+)?\\\\))?\""
msgstr ""

#: src/reference/all-settings.md:4475
msgid "\"))\""
msgstr ""

#: src/reference/all-settings.md:4476
msgid "\"# which must be followed by a matching quote\""
msgstr ""

#: src/reference/all-settings.md:4477
msgid "\"(?(<quote>)\\\\k<quote>)\""
msgstr ""

#: src/reference/all-settings.md:4478
msgid "\"# and optionally a single closing symbol\""
msgstr ""

#: src/reference/all-settings.md:4479
msgid "\"[)}\\\\]>]?\""
msgstr ""

#: src/reference/all-settings.md:4480
msgid "\"# if line/column matched, may be followed by a description\""
msgstr ""

#: src/reference/all-settings.md:4481
msgid "\"(?(<line_column>):[^ 0-9][^ ]*)?\""
msgstr ""

#: src/reference/all-settings.md:4482
msgid "\"# which may be followed by trailing punctuation\""
msgstr ""

#: src/reference/all-settings.md:4483
msgid "\"[.,:)}\\\\]>]*\""
msgstr ""

#: src/reference/all-settings.md:4484
msgid "\"# and always includes trailing whitespace or end of line\""
msgstr ""

#: src/reference/all-settings.md:4485
msgid "\"([ ]+|$)\""
msgstr ""

