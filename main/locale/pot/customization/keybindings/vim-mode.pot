msgstr ""

#: src/vim.md:631
msgid "gutter.line_numbers"
msgstr ""

#: src/vim.md:631
msgid ""
"Controls the display of line numbers in the gutter. Set the "
"`\"line_numbers\"` property to `false` to hide line numbers."
