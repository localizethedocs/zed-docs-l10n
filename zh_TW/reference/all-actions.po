msgstr ""

#: src/all-actions.md:10
msgid ""
"NOTE: This does **not** wait for asynchronous actions to complete before "
"running the next action.<br> Keymap Name: <code>action::Sequence</code><br>"
msgstr ""

#: src/all-actions.md:497
msgid ""
"Does not apply to platform menu bars (e.g. on macOS).<br> Keymap Name: "
"<code>app_menu::ActivateMenuLeft</code><br>"
msgstr ""

