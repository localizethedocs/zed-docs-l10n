msgstr ""

#: src/reference/all-settings.md:4627
msgid ""
"Description: Regexes used to identify path hyperlinks. The regexes can be "
"specified in two forms - a single regex string, or an array of strings "
"(which will be collected into a single multi-line regex string)."
msgstr ""

#: src/reference/all-settings.md:4628
msgid "Setting: `path_hyperlink_regexes`"
msgstr ""

#: src/reference/all-settings.md:4634
msgid "\"path_hyperlink_regexes\""
msgstr ""

#: src/reference/all-settings.md:4635
msgid ""
"// Python-style diagnostics\n"
"      \"File \\\"(?<path>[^\\\"]+)\\\", line (?<line>[0-9]+)\""
msgstr ""

#: src/reference/all-settings.md:4637
msgid ""
"// Common path syntax with optional line, column, description, trailing "
"punctuation, or\n"
"      // surrounding symbols or quotes\n"
msgstr ""

#: src/reference/all-settings.md:4640
msgid "\"(?x)\""
msgstr ""

#: src/reference/all-settings.md:4641
msgid "\"# optionally starts with 0-2 opening prefix symbols\""
msgstr ""

#: src/reference/all-settings.md:4642
msgid "\"[({\\\\[<]{0,2}\""
msgstr ""

#: src/reference/all-settings.md:4643
msgid "\"# which may be followed by an opening quote\""
msgstr ""

#: src/reference/all-settings.md:4644
msgid "\"(?<quote>[\\\"'`])?\""
msgstr ""

#: src/reference/all-settings.md:4645
msgid "\"# `path` is the shortest sequence of any non-space character\""
msgstr ""

#: src/reference/all-settings.md:4646
msgid "\"(?<link>(?<path>[^ ]+?\""
msgstr ""

#: src/reference/all-settings.md:4647
msgid "\"    # which may end with a line and optionally a column,\""
msgstr ""

#: src/reference/all-settings.md:4648
msgid ""
"\"    (?<line_column>:+[0-9]+(:[0-9]+)?|:?\\\\([0-9]+([,:][0-9]+)?\\\\))?\""
msgstr ""

#: src/reference/all-settings.md:4649
msgid "\"))\""
msgstr ""

#: src/reference/all-settings.md:4650
msgid "\"# which must be followed by a matching quote\""
msgstr ""

#: src/reference/all-settings.md:4651
msgid "\"(?(<quote>)\\\\k<quote>)\""
msgstr ""

#: src/reference/all-settings.md:4652
msgid "\"# and optionally a single closing symbol\""
msgstr ""

#: src/reference/all-settings.md:4653
msgid "\"[)}\\\\]>]?\""
msgstr ""

#: src/reference/all-settings.md:4654
msgid "\"# if line/column matched, may be followed by a description\""
msgstr ""

#: src/reference/all-settings.md:4655
msgid "\"(?(<line_column>):[^ 0-9][^ ]*)?\""
msgstr ""

#: src/reference/all-settings.md:4656
msgid "\"# which may be followed by trailing punctuation\""
msgstr ""

#: src/reference/all-settings.md:4657
msgid "\"[.,:)}\\\\]>]*\""
msgstr ""

#: src/reference/all-settings.md:4658
msgid "\"# and always includes trailing whitespace or end of line\""
msgstr ""

#: src/reference/all-settings.md:4659
msgid "\"([ ]+|$)\""
msgstr ""

