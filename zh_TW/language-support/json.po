msgid "\"runtime.version\""
msgstr ""

#: src/languages/json.md:48
msgid "\"Lua 5.4\""
msgstr ""

#: src/languages/json.md:52
msgid "Schema Specification via Settings"
msgstr ""

#: src/languages/json.md:54
msgid ""
"You can associate JSON Schemas with file paths using relative paths in your "
"language server settings. Zed resolves paths relative to your project root:"
msgstr ""

