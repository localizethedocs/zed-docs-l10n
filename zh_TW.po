#: src/key-bindings.md:254
msgid ""
"// Expand the selection (editor::SelectLargerSyntaxNode);\n"
"      // copy to the clipboard; and then undo the selection expansion.\n"
"      \"cmd-alt-c\""
msgstr ""

#: src/key-bindings.md:258
msgid ""
"\"ctrl-shift-right ctrl-shift-right ctrl-shift-right cmd-c ctrl-shift-left "
"ctrl-shift-left ctrl-shift-left\""
msgstr ""

#: src/key-bindings.md:263
