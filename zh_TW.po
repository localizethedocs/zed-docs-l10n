#: src/vim.md:411
msgid "vim_mode == replace"
msgstr ""

#: src/vim.md:411
msgid "Replace mode"
msgstr "取代模式"

#: src/vim.md:412
msgid "vim_mode == waiting"
msgstr ""

#: src/vim.md:412
msgid "Waiting for an arbitrary key (e.g., after typing `f` or `t`)"
msgstr ""

#: src/vim.md:413
msgid "vim_mode == operator"
msgstr ""

#: src/vim.md:413
msgid "Waiting for another binding to trigger (e.g., after typing `c` or `d`)"
msgstr ""

#: src/vim.md:414
msgid "vim_operator"
msgstr ""

#: src/vim.md:414
msgid ""
"Set to `none` unless `vim_mode == operator`, in which case it is set to the "
"current operator's default keybinding (e.g., after typing `d`, `vim_operator "
"== d`)"
msgstr ""

#: src/vim.md:416
msgid ""
"**Note**: Contexts are matched only on one level at a time. So it is "
"possible to use the expression `\"Editor && vim_mode == normal\"`, but "
"`\"Workspace && vim_mode == normal\"` will never match because we set the "
"vim context at the `\"Editor\"` level."
msgstr ""

