msgstr ""

#: src/key-bindings.md:73
msgid ""
"[macOS](https://github.com/zed-industries/zed/blob/main/assets/keymaps/"
"default-macos.json)"
msgstr ""

#: src/key-bindings.md:74
msgid ""
