msgstr "`format_on_save`"

#: src/migrate/intellij.md:51
msgid "Auto-format when saving. Set to `\"on\"` to enable."
msgstr ""

#: src/migrate/intellij.md:52
msgid "`soft_wrap`"
msgstr ""

#: src/migrate/intellij.md:52
msgid ""
"Wrap long lines. Options: `\"none\"`, `\"editor_width\"`, "
"`\"preferred_line_length\"`"
msgstr ""

#: src/migrate/intellij.md:53
