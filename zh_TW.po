msgstr ""

#: src/development/windows.md:253
msgid "`ERROR_INITIALIZATION_FAILED`"
msgstr ""

#: src/development/windows.md:254
msgid "`GPU Crashed`"
msgstr ""

#: src/development/windows.md:255
msgid "`ERROR_SURFACE_LOST_KHR`"
msgstr ""

#: src/development/windows.md:257
msgid ""
"Vulkan may not be working correctly on your system. Updating GPU drivers "
